{
  "name": "@q1travel/app-authorization-chrome-extension",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "dist",
    "testing/index.js",
    "testing/index.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./testing/index.d.ts",
      "import": "./testing/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "build": "node scripts/stage-package.mjs clean && tsc -p tsconfig.build.json && tsc -p tsconfig.testing.json && node scripts/stage-package.mjs finalize",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  }
}
