{
  "name": "@q1travel/app-authorization",
  "version": "0.1.0",
  "description": "Unified authorization runtime for browser extensions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/q1travel-labs/q1travel-app-authorization.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "check:pack": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "react": "18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
